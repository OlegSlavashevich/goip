# Public IPv4 address of the VM. Asterisk puts it into SIP/SDP.
PUBLIC_IP=203.0.113.10

# Public IPv4 address from which the GoIP reaches this VM.
GOIP_PUBLIC_IP=198.51.100.20

# GoIP registers this SIP account on the VM.
SIP_USERNAME=1001
SIP_PASSWORD=replace-with-a-long-random-password

# Networks that Asterisk may advertise as local. Keep Docker's subnet here.
LOCAL_NETWORK=172.16.0.0/12

# First test: record only, then hang up after CALL_MAX_SECONDS.
# Change to "proxy" after the SIP/audio test succeeds.
BRIDGE_MODE=record
CALL_MAX_SECONDS=10
RECORD_CALLS=true

# Existing ai-websocket-proxy endpoint. Required only in BRIDGE_MODE=proxy.
PROXY_WS_URL=wss://gemini-proxy.inoperate.com/v1/live
PROXY_SHARED_TOKEN=replace-with-the-token-used-by-ai-websocket-proxy

# The same Gemini session settings and real-estate scenario that Voximplant
# previously ran. "real-estate" is the default; use "simple" for the old demo.
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
BOT_PROFILE=real-estate
BOT_PAGE_URL=https://kakdoma-sutochno.ru/assist/
BOT_DATE_UTC_OFFSET=+03:00
BOT_VOICE_NAME=Erinome
BOT_MAX_CALL_DURATION_MS=1200000

# Safety switch. Keep false until the dry-run dialogue and legal process have
# been verified. true permits the scenario to call the real booking endpoint.
ALLOW_CONFIRM_BOOKING=false

# Used only when BOT_PROFILE=simple.
SYSTEM_INSTRUCTION=Ты голосовой помощник. Отвечай кратко и естественно на русском языке.
INITIAL_TEXT=Начни разговор коротким приветствием на русском языке.

# Safety limits for buffered audio.
MAX_PENDING_AUDIO_BYTES=1048576
MAX_PLAYBACK_AUDIO_BYTES=1048576
