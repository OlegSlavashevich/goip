[global]
type=global
user_agent=goip-ai-bridge

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_signaling_address=${PUBLIC_IP}
external_media_address=${PUBLIC_IP}
local_net=${LOCAL_NETWORK}

; The endpoint, auth object and address-of-record intentionally share a name.
; This lets PJSIP identify REGISTER and INVITE requests by the SIP username.
[${SIP_USERNAME}]
type=endpoint
transport=transport-udp
context=from-goip
disallow=all
allow=alaw
allow=ulaw
auth=${SIP_USERNAME}
aors=${SIP_USERNAME}
identify_by=username,auth_username
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
language=en

[${SIP_USERNAME}]
type=auth
auth_type=userpass
username=${SIP_USERNAME}
password=${SIP_PASSWORD}

[${SIP_USERNAME}]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

; Registration-free trunk mode for the GoIP gateway.
; Only SIP received from the configured GoIP public IP reaches this endpoint.
[goip-trunk]
type=endpoint
transport=transport-udp
context=from-goip
disallow=all
allow=alaw
allow=ulaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733

[goip-trunk-identify]
type=identify
endpoint=goip-trunk
match=${GOIP_PUBLIC_IP}
